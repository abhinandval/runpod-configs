# Model source. The default is the Qwen3.8 27B Q4_K_M GGUF listed by ggml-org.
MODEL_HF_REF=ggml-org/Qwen3.8-27B-GGUF:Q4_K_M
# Set MODEL_PATH to a file already present on container disk to bypass Hugging
# Face resolution. Leave empty to use MODEL_HF_REF.
MODEL_PATH=
# Container disk is ephemeral; new workers redownload the model.
MODEL_CACHE_DIR=/models
LLAMA_CACHE=/models

# Memory-envelope defaults for exactly one 24-GB GPU worker.
N_CTX=32768
N_PARALLEL=1
N_GPU_LAYERS=999
N_BATCH=256
N_UBATCH=128
THREADS=0

# Server and handler behavior.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_STARTUP_TIMEOUT_SECONDS=900
# Must remain at or below the endpoint execution timeout configured at create time (180s).
REQUEST_TIMEOUT_SECONDS=180
DEFAULT_MAX_TOKENS=256
MAX_REQUEST_TOKENS=2048
# Optional local llama-server authentication. RunPod endpoint auth remains
# managed by RunPod and is not configured here.
LLAMA_API_KEY=
FLASH_ATTN=
LLAMA_EXTRA_ARGS=
