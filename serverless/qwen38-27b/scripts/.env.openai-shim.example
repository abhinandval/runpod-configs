# Required: the RunPod Queue endpoint to proxy.
RUNPOD_ENDPOINT_ID=replace-with-queue-endpoint-id

# Required: a RunPod API key authorized to submit and read jobs for this endpoint.
# Keep this file private; do not commit it or put this value in the image.
RUNPOD_API_KEY=replace-with-runpod-api-key

# Required: a separate, high-entropy key for clients of this VPS proxy.
# Do not reuse RUNPOD_API_KEY here.
OPENAI_SHIM_API_KEY=replace-with-a-long-random-secret

# Optional API presentation and timeout settings.
OPENAI_SHIM_MODEL=qwen38-27b-q4_k_m
OPENAI_SHIM_WAIT_SECONDS=180
